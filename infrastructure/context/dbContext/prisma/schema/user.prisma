model User {
  id         String     @unique
  name       String
  lastName   String
  nationalId String
  mobile     String
  status     userStatus
  password   String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  bankAccounts  BankAccount[]
  tickets       Ticket[]
  userInqueries UserInquery?
}

enum userStatus {
  Active
  Inactive
}
