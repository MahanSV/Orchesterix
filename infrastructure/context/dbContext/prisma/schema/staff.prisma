model Staff {
  id         String      @unique
  name       String
  lastName   String
  nationalId String
  role       staffRole
  status     staffStatus
  password   String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  ticket     Ticket?
}

enum staffRole {
  Admin
  Support
  Manager
}

enum staffStatus {
  Active
  Inactive
}
