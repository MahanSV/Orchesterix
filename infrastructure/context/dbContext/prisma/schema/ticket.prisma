model Ticket {
  id          String    @unique
  description String
  attachment  String
  status      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  closedAt    DateTime?
  userId      String
  staffId     String?   @unique

  user  User   @relation(fields: [userId], references: [id])
  staff Staff? @relation(fields: [staffId], references: [id])
}
